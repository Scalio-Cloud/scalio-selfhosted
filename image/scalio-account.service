[Unit]
Description=Scalio: administrator account on the console (VM image, no default account)
After=systemd-user-sessions.service
Before=getty@tty1.service
ConditionPathExists=!/var/lib/scalio/account-done

[Service]
Type=oneshot
ExecStart=/opt/scalio-image/scalio-account.sh
StandardInput=tty
StandardOutput=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
