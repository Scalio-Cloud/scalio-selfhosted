[Unit]
Description=Scalio: install Docker and Scalio Installer on the first boot
Wants=network-online.target
After=network-online.target cloud-final.service

[Service]
Type=oneshot
ExecStart=/opt/scalio-image/scalio-firstboot.sh
RemainAfterExit=yes
StandardOutput=journal+console

[Install]
WantedBy=multi-user.target
